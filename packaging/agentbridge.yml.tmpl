# AgentBridge Desktop — Flatpak manifest (rendered per release).
#
# .github/workflows/linux-release.yml renders this template into packaging/agentbridge.yml
# (gitignored) replacing the @@VERSION@@ / @@SHA256@@ / @@CLIENT_VERSION@@ /
# @@CLIENT_SHA256@@ placeholders, then runs flatpak-builder on the result.
#
# Layout model:
#   /app/lib/agentbridge            read-only "installer image" = the exact contents of the
#                                   AgentBridge linux-x64 release archive for this version
#                                   (single-file `agent`, docs/, scripts/, Tools/,
#                                   OfficeManager/, voices/, kokoro.onnx, .playwright,
#                                   Lingua/, GiraffeAIWebClient/) plus a version marker.
#   $XDG_DATA_HOME/agentbridge/engine  writable materialized copy created on first launch
#                                   (agent-run / agent-desktop). The engine keeps its
#                                   user-editable config under PersistentData/ NEXT TO the
#                                   executable (AppConfig), and /app is read-only in a
#                                   Flatpak — so the payload must run from a writable copy.
#                                   The marker file makes updates refresh binaries while
#                                   preserving PersistentData (never part of an archive).
#
# Two entry points (both installed in /app/bin):
#   agent-run       default command / "AgentBridge (Terminal)" — runs the engine TUI.
#   agent-desktop   "AgentBridge" — starts the engine headless when needed and opens the
#                   bundled Giraffe AI web client in a desktop WebKitGTK window,
#                   auto-connected to the local engine (?provider= handshake).
app-id: io.github.graphene_lab.agentbridge
runtime: org.gnome.Platform
runtime-version: '48'
sdk: org.gnome.Sdk
command: agent-run

# The engine is a self-hosted server + chat client: it talks to LLM providers over the
# network, indexes/opens the user's files, plays/records audio and shows a terminal UI or
# a WebKitGTK window. The sandbox is therefore deliberately broad — this package is the
# Flatpak equivalent of the plain ~/.agentbridge tar.gz install, not a restricted store app.
finish-args:
  - --share=ipc
  - --share=network
  - --socket=x11
  - --socket=wayland
  - --socket=fallback-x11
  - --socket=pulseaudio
  - --device=dri
  - --filesystem=home
  - --talk-name=org.freedesktop.Notifications
  - --talk-name=org.freedesktop.secrets

modules:
  # ── Engine payload ────────────────────────────────────────────────────────────
  # The release archive has NO wrapping top-level directory (the AgentBridge CI tars the
  # publish/ output), hence strip-components: 0. Self-contained single-file: no .NET SDK
  # needed at build or on the client.
  - name: agentbridge-engine
    buildsystem: simple
    build-commands:
      - mkdir -p /app/lib/agentbridge
      - cp -a . /app/lib/agentbridge/
      - printf '%s\n' '@@VERSION@@' > /app/lib/agentbridge/agentbridge-version.txt
    sources:
      - type: archive
        url: https://github.com/Graphene-Lab/AgentBridge/releases/download/v@@VERSION@@/agentbridge-linux-x64.tar.gz
        sha256: "@@SHA256@@"
        strip-components: 0
        only-arches:
          - x86_64

  # ── Giraffe AI web client (the desktop GUI) ──────────────────────────────────
  # The engine normally downloads this client at first startup from the GiraffeAI GitHub
  # releases; here it ships pre-seeded inside the image so the desktop experience works
  # offline and is pinned to the client version released at build time. Its update check
  # (WebClientUpdater) runs with the engine's --no-update flag off only when the user
  # launches the engine with explicit args; the desktop/terminal entries keep it pinned.
  - name: giraffeai-webclient
    buildsystem: simple
    build-commands:
      - mkdir -p /app/lib/agentbridge/GiraffeAIWebClient
      - cp -a . /app/lib/agentbridge/GiraffeAIWebClient/
      - printf '%s\n' '@@CLIENT_VERSION@@' > /app/lib/agentbridge/GiraffeAIWebClient/version.txt
    sources:
      - type: archive
        url: https://github.com/Graphene-Lab/GiraffeAI/releases/download/v@@CLIENT_VERSION@@/giraffeai-@@CLIENT_VERSION@@.zip
        sha256: "@@CLIENT_SHA256@@"
        strip-components: 0

  # ── Launchers + desktop integration ───────────────────────────────────────────
  # branding/ (committed): agent-run, agent-desktop, the two .desktop entries, the
  # metainfo file and giraffe.svg (logo source). ../build-icons/ (generated by the
  # workflow at the repo root as build-icons/icons/hicolor/<size>/apps/<appid>.png,
  # gitignored) supplies the icons.
  - name: branding
    buildsystem: simple
    sources:
      - type: dir
        path: branding
      - type: dir
        path: ../build-icons
    build-commands:
      - install -Dm755 agent-run /app/bin/agent-run
      - install -Dm755 agent-desktop /app/bin/agent-desktop
      - install -Dm644 io.github.graphene_lab.agentbridge.desktop /app/share/applications/io.github.graphene_lab.agentbridge.desktop
      - install -Dm644 io.github.graphene_lab.agentbridge.Terminal.desktop /app/share/applications/io.github.graphene_lab.agentbridge.Terminal.desktop
      - install -Dm644 io.github.graphene_lab.agentbridge.metainfo.xml /app/share/metainfo/io.github.graphene_lab.agentbridge.metainfo.xml
      - for s in 64 128 256 512; do install -Dm644 icons/hicolor/${s}x${s}/apps/io.github.graphene_lab.agentbridge.png /app/share/icons/hicolor/${s}x${s}/apps/io.github.graphene_lab.agentbridge.png; done
