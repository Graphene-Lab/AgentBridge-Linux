# AgentBridge FROM SOURCE — experimental proof manifest (x86_64).
#
# Rendered by .github/workflows/sourcebuild-proof.yml into packaging/source/agentbridge.yml
# (gitignored). NOT part of the release pipeline.
#
# Validates the Flathub-style build model: the ENGINE is compiled from the AgentBridge
# source tag inside the sandbox (no prebuilt archive wrapped), NuGet restored OFFLINE
# from a local feed staged by nuget-sources.json (flatpak-dotnet-generator), using the
# official .NET SDK tarball as a module source.
#
# Module-local staging (prepared by the workflow in packaging/.proof-staging/payload,
# gitignored, extracted from the release archive so no extra network downloads):
#   kokoro.onnx            → dropped at the repo root of the engine module so the csproj
#                            DownloadKokoroModel target copies it (never curls at build)
#   Tools/  .playwright/   → release-data module overlays them into /app/lib/agentbridge
#
app-id: io.github.graphene_lab.agentbridge
runtime: org.gnome.Platform
runtime-version: '48'
sdk: org.gnome.Sdk
command: agent-run

finish-args:
  - --share=ipc
  - --share=network
  - --socket=x11
  - --socket=wayland
  - --socket=fallback-x11
  - --socket=pulseaudio
  - --device=dri
  - --filesystem=home
  - --talk-name=org.freedesktop.Notifications
  - --talk-name=org.freedesktop.secrets

modules:
  # ── Engine compiled from source, offline restore ─────────────────────────────
  - name: agentbridge-source
    buildsystem: simple
    build-commands:
      - |
        export DOTNET_ROOT="$PWD/dotnet-sdk"
        export PATH="$DOTNET_ROOT:$PATH"
        export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
        export DOTNET_CLI_HOME="$PWD/.dotnet" NUGET_PACKAGES="$PWD/.nuget"
        export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
        dotnet publish AgentBridge.csproj -c Release -r linux-x64 \
          --self-contained true \
          -p:PublishSingleFile=true \
          -p:IncludeNativeLibrariesForSelfExtract=true \
          -p:DebugType=None -p:DebugSymbols=false \
          -p:RestoreSources="$PWD/nuget-sources" \
          -p:NuGetAudit=false \
          -o publish-out
        test -d publish-out || { echo "ERROR: dotnet publish produced no publish-out" >&2; exit 1; }
        mkdir -p /app/lib/agentbridge
        cp -a publish-out/. /app/lib/agentbridge/
        printf '%s\n' '@@VERSION@@' > /app/lib/agentbridge/agentbridge-version.txt
    sources:
      - type: git
        url: https://github.com/Graphene-Lab/AgentBridge
        commit: '@@COMMIT@@'
      - type: archive
        url: https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.400/dotnet-sdk-10.0.400-linux-x64.tar.gz
        sha256: "@@SDK_SHA256@@"
        dest: dotnet-sdk
        only-arches:
          - x86_64
      # The workflow render step merges the flatpak-dotnet-generator output
      # (packaging/source/nuget-sources.json — one "file" source per nupkg, all into
      # ./nuget-sources) into THIS module's sources list, so flatpak-builder
      # pre-downloads the whole offline feed before the build.
      # Seed kokoro.onnx at the repo root: the csproj target copies it instead of
      # curling (build commands have no network).
      - type: file
        path: ../.proof-staging/payload/kokoro.onnx

  # ── Data overlay that the engine source build cannot produce offline ─────────
  # Tools/ plugins and the .playwright driver payload, extracted from the release
  # archive by the workflow (staged as local dir source — no extra download).
  - name: release-data
    buildsystem: simple
    sources:
      - type: dir
        path: ../.proof-staging/payload
    build-commands:
      - install -d /app/lib/agentbridge
      - cp -a Tools /app/lib/agentbridge/ 2>/dev/null || true
      - cp -a .playwright /app/lib/agentbridge/ 2>/dev/null || true
      - cp -a kokoro.onnx /app/lib/agentbridge/ 2>/dev/null || true

  # ── Giraffe AI web client (the desktop GUI) ──────────────────────────────────
  - name: giraffeai-webclient
    buildsystem: simple
    build-commands:
      - mkdir -p /app/lib/agentbridge/GiraffeAIWebClient
      - cp -a . /app/lib/agentbridge/GiraffeAIWebClient/
      - printf '%s\n' '@@CLIENT_VERSION@@' > /app/lib/agentbridge/GiraffeAIWebClient/version.txt
    sources:
      - type: archive
        url: https://github.com/Graphene-Lab/GiraffeAI/releases/download/v@@CLIENT_VERSION@@/giraffeai-@@CLIENT_VERSION@@.zip
        sha256: "@@CLIENT_SHA256@@"
        strip-components: 0

  # ── Launchers + desktop integration (same files as the release pipeline) ──────
  - name: branding
    buildsystem: simple
    sources:
      - type: dir
        path: ../branding
      - type: dir
        path: ../../build-icons
    build-commands:
      - install -Dm755 agent-run /app/bin/agent-run
      - install -Dm755 agent-desktop /app/bin/agent-desktop
      - install -Dm644 io.github.graphene_lab.agentbridge.desktop /app/share/applications/io.github.graphene_lab.agentbridge.desktop
      - install -Dm644 io.github.graphene_lab.agentbridge.Terminal.desktop /app/share/applications/io.github.graphene_lab.agentbridge.Terminal.desktop
      - install -Dm644 io.github.graphene_lab.agentbridge.metainfo.xml /app/share/metainfo/io.github.graphene_lab.agentbridge.metainfo.xml
      - for s in 64 128 256 512; do install -Dm644 icons/hicolor/${s}x${s}/apps/io.github.graphene_lab.agentbridge.png /app/share/icons/hicolor/${s}x${s}/apps/io.github.graphene_lab.agentbridge.png; done
